# Published by .github/workflows/server-image.yml.
SANDY_IMAGE=ghcr.io/OWNER/REPOSITORY-server:latest
SANDY_PORT=3000

# Generate and store these in a password manager. Do not commit deploy/.env.
SECRET_KEY_BASE=replace-with-output-from-openssl-rand-hex-64
SETUP_TOKEN=replace-with-a-long-random-first-run-token

# Public host/origin used by Rails host authorization and Action Cable.
APP_HOST=sandy.example.com
APP_ORIGIN=https://sandy.example.com

# Conservative single-family defaults.
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
