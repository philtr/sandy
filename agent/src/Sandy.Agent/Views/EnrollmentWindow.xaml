<Window x:Class="Sandy.Agent.Views.EnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Sandy" Width="520" Height="660" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="White"
        WindowStartupLocation="CenterScreen">
  <Border Margin="12" Background="{StaticResource PageBrush}" BorderBrush="#805A9FF5"
          BorderThickness="1" CornerRadius="24">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.6" Color="#FF000000" />
    </Border.Effect>
    <Grid ClipToBounds="True">
      <Grid.Background>
        <RadialGradientBrush Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="0.82" RadiusY="0.62">
          <GradientStop Color="#173A6A" Offset="0" />
          <GradientStop Color="#0C1727" Offset="0.5" />
          <GradientStop Color="#090E16" Offset="1" />
        </RadialGradientBrush>
      </Grid.Background>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="22,18,18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="32" Height="32" Source="{StaticResource SandyLogoImage}" />
          <TextBlock Margin="10,0,0,0" Text="Sandy" FontSize="22" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Width="36" Height="36" Content="×" FontSize="22" Padding="0"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Close"
                Click="Close_Click" />
      </Grid>

      <Border Grid.Row="1" Margin="22,22,22,24" Padding="26,24"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="HeadingText" FontSize="28" FontWeight="SemiBold" Text="Connect this PC" />
          <TextBlock x:Name="InstructionsText" Grid.Row="1" Margin="0,8,0,22" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}"
                     Text="Enter the server address and family join code shown to a parent." />

          <StackPanel Grid.Row="2">
            <TextBlock Margin="2,0,0,0" Text="Server address" FontWeight="SemiBold" />
            <TextBox x:Name="ServerUrl" Margin="0,7,0,15" Style="{StaticResource LauncherTextBoxStyle}"
                     Text="https://sandy.example.com" />
          </StackPanel>
          <StackPanel Grid.Row="3">
            <TextBlock Margin="2,0,0,0" Text="Family join code" FontWeight="SemiBold" />
            <TextBox x:Name="JoinCode" Margin="0,7,0,15" Style="{StaticResource LauncherTextBoxStyle}"
                     CharacterCasing="Upper" />
          </StackPanel>
          <StackPanel Grid.Row="4">
            <TextBlock Margin="2,0,0,0" Text="Device name" FontWeight="SemiBold" />
            <TextBox x:Name="DeviceName" Margin="0,7,0,20" Style="{StaticResource LauncherTextBoxStyle}" />
          </StackPanel>
          <StackPanel Grid.Row="5">
            <Button x:Name="ConnectButton" Height="46" Content="Connect" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" FontSize="16"
                    VerticalContentAlignment="Center" Click="Connect_Click" />
            <TextBlock x:Name="ErrorText" Margin="2,13,2,0" Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
