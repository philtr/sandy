<Window x:Class="Sandy.Agent.Views.SandyTaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Height="48"
        Background="#F50B111B" Foreground="White" WindowStartupLocation="Manual">
  <Border BorderBrush="#3D71808F" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0">
    <Grid Margin="10,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="HomeButton" Style="{StaticResource TaskbarHomeButtonStyle}"
              Width="42" Height="40" ToolTip="Sandy Home" Click="Home_Click">
        <Image Width="24" Height="24" Source="{StaticResource SandyLogoImage}" />
      </Button>
      <StackPanel x:Name="PinnedPanel" Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal" />
      <Border Grid.Column="2" Width="1" Margin="10,6" Background="#6671808F" />
      <Grid Grid.Column="3" ClipToBounds="True">
        <StackPanel x:Name="RunningPanel" Orientation="Horizontal" HorizontalAlignment="Left" />
      </Grid>

      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="NetworkStatusIcon" Width="34" Height="34" ToolTip="Checking network status">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Path x:Name="NetworkWaves" Stroke="#DCE5F2" StrokeThickness="1.9" StrokeStartLineCap="Round"
                    Data="M 2,8 C 7,3 17,3 22,8 M 5.5,12 C 9,8.7 15,8.7 18.5,12 M 9,16 C 10.8,14.2 13.2,14.2 15,16" />
              <Ellipse x:Name="NetworkDot" Canvas.Left="11" Canvas.Top="19" Width="2" Height="2" Fill="#DCE5F2" />
            </Canvas>
          </Viewbox>
        </Border>
        <Border Width="82" Margin="4,0,3,0" Padding="7,4" CornerRadius="12" BorderBrush="#6671808F" BorderThickness="1"
                Background="#66192330">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse x:Name="TaskbarConnectionDot" Width="7" Height="7" Margin="0,0,5,0" Fill="#F4B942" />
            <TextBlock x:Name="TaskbarConnectionText" Text="Connecting" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Width="78" Margin="5,0" VerticalAlignment="Center">
          <TextBlock x:Name="TaskbarRemainingText" Text="--:--" FontFamily="Consolas" FontSize="14"
                     FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock x:Name="EditLeaseText" Foreground="#67A8FF" FontSize="9" TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="TaskbarClockText" Width="48" Margin="2,0,6,0" Text="8:42" FontSize="14"
                   TextAlignment="Center" VerticalAlignment="Center" />
        <Button Style="{StaticResource TaskbarButtonStyle}" Width="34" Height="34" ToolTip="Account" Click="Account_Click">
          <Viewbox Width="17" Height="17">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="8" Canvas.Top="3" Width="8" Height="8" Fill="#DCE5F2" />
              <Path Fill="#DCE5F2" Data="M 4,22 C 4.5,15 8,12.5 12,12.5 C 16,12.5 19.5,15 20,22 Z" />
            </Canvas>
          </Viewbox>
        </Button>
        <Button Style="{StaticResource TaskbarButtonStyle}" Width="34" Height="34" Margin="4,0,0,0"
                ToolTip="Power" Click="Power_Click">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Path Stroke="#DCE5F2" StrokeThickness="2" StrokeStartLineCap="Round" Data="M 12,2 L 12,11" />
              <Path Stroke="#DCE5F2" StrokeThickness="2" StrokeStartLineCap="Round"
                    Data="M 6.3,5.6 C 2,9.5 3,16.5 7.3,19.5 C 10,21.5 14,21.5 16.7,19.5 C 21,16.5 22,9.5 17.7,5.6" />
            </Canvas>
          </Viewbox>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
