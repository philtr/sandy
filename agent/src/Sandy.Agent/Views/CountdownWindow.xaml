<Window x:Class="Sandy.Agent.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="210" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" IsHitTestVisible="False">
  <Border Background="#EE1E2430" BorderBrush="#FFFFB300" BorderThickness="3" CornerRadius="18" Padding="28">
    <StackPanel HorizontalAlignment="Center">
      <TextBlock Foreground="White" FontSize="24" Text="PC screentime ends in" HorizontalAlignment="Center" />
      <TextBlock x:Name="RemainingText" Foreground="#FFFFC247" FontSize="72" FontWeight="Bold"
                 Text="1:00" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
