<Window x:Class="Sandy.Agent.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" Height="224" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Transparent" Foreground="White">
  <Border Margin="8" Background="{StaticResource SurfaceOpaqueBrush}"
          BorderBrush="#805A9FF5" BorderThickness="1" CornerRadius="20" Padding="22">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#FF000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="26" Height="26" CornerRadius="8" Background="#173A6A"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
          <TextBlock Text="S" FontSize="15" FontWeight="Black" Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Margin="9,0,0,0" Text="Sandy · Screen time" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,13,0,12" Foreground="White"
                 FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"
                 TextAlignment="Left" TextWrapping="Wrap" />

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="38" Height="38" AutomationProperties.Name="Auto-dismiss countdown">
          <Ellipse Stroke="#40FFFFFF" StrokeThickness="4" />
          <Ellipse Stroke="{StaticResource WarningBrush}" StrokeThickness="4" StrokeDashArray="10 18"
                   StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform />
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                        From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>
          <TextBlock x:Name="CountdownText" Text="10" Foreground="White" FontSize="13"
                     FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Closes automatically"
                   Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" />
        <Button Grid.Column="2" MinWidth="96" Style="{StaticResource SecondaryButtonStyle}"
                Content="Got it" VerticalAlignment="Center" Click="Close_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
