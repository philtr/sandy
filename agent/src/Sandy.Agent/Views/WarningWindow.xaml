<Window x:Class="Sandy.Agent.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="190" WindowStyle="None" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#F21E2430">
  <Border BorderBrush="#FFFFB300" BorderThickness="3" Padding="24">
    <StackPanel>
      <TextBlock x:Name="MessageText" Foreground="White" FontSize="28" FontWeight="SemiBold"
                 TextAlignment="Center" TextWrapping="Wrap" />
      <Button Margin="0,20,0,0" Width="110" Height="36" Content="Got it" Click="Close_Click" />
    </StackPanel>
  </Border>
</Window>
