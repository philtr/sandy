<Window x:Class="Sandy.Agent.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sandy" Width="380" Height="250" WindowStartupLocation="CenterScreen"
        Background="#151923" Foreground="White">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="PC Screentime" />
    <TextBlock x:Name="RemainingText" Grid.Row="1" FontSize="52" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Center" Text="Connecting…" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
      <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#F4B942" Margin="0,0,7,0" />
      <TextBlock x:Name="ConnectionText" Foreground="#B8BFCC" Text="Connecting" />
    </StackPanel>
  </Grid>
</Window>
