<Window x:Class="Sandy.Agent.Views.ExpiredOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="#FF090B10" Foreground="White" WindowState="Normal">
  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
      <TextBlock FontSize="70" Text="Time’s up" FontWeight="Bold" TextAlignment="Center" />
      <TextBlock Margin="0,18,0,0" FontSize="26" Foreground="#B8BFCC" TextAlignment="Center"
                 TextWrapping="Wrap" Text="Ask a parent for more time. This screen will disappear automatically when time is added." />
    </StackPanel>
  </Grid>
</Window>
