<Window x:Class="Sandy.Agent.Views.ExpiredOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource PageBrush}" Foreground="White" WindowState="Normal">
  <Grid Background="{StaticResource PageGradientBrush}">
    <StackPanel Margin="28,24,0,0" Orientation="Horizontal"
                HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border Width="32" Height="32" CornerRadius="9" Background="#173A6A"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <TextBlock Text="S" FontSize="19" FontWeight="Black" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
      </Border>
      <TextBlock Margin="10,0,0,0" Text="Sandy" FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <Border MaxWidth="720" Margin="32" Padding="48,42" Background="{StaticResource SurfaceBrush}"
            BorderBrush="#805A9FF5" BorderThickness="1" CornerRadius="24"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <Border Width="64" Height="64" CornerRadius="20" Background="#2A67A8FF"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
          <TextBlock Text="S" FontSize="36" FontWeight="Black" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
        </Border>
        <TextBlock Margin="0,20,0,0" FontSize="66" Text="Time’s up" FontWeight="Bold"
                   TextAlignment="Center" />
        <TextBlock Margin="0,16,0,0" FontSize="24" Foreground="{StaticResource MutedBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Text="Ask a parent for more time. This screen will disappear automatically when time is added." />
      </StackPanel>
    </Border>
  </Grid>
</Window>
