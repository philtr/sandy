<Window x:Class="Sandy.Agent.Views.VolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume" Width="340" Height="150" ResizeMode="NoResize" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner" Background="#0D131E" Foreground="White">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Volume" FontSize="19" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal">
      <CheckBox x:Name="MuteCheck" Content="Mute" Margin="0,0,14,0" VerticalAlignment="Center" Click="Mute_Click" />
      <Slider x:Name="VolumeSlider" Width="210" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" />
    </StackPanel>
  </Grid>
</Window>
