<% content_for :title, "Add a PC" %>
<section class="panel narrow center auth-card">
  <div class="result-icon" aria-hidden="true">+</div>
  <p class="eyebrow">Add PC</p>
  <h1>Connect another <span class="gradient-text">PC</span></h1>
  <p>Generate a join code, then enter it in the Sandy agent on the PC you want to add.</p>
  <div class="button-row centered">
    <%= button_to "Create join code", enrollment_code_path, method: :patch, class: "primary-button" %>
    <%= link_to "Return to dashboard", root_path, class: "secondary-button" %>
  </div>
</section>
