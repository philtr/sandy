<% content_for :title, "Sign in to Sandy" %>
<section class="panel narrow auth-card">
  <div class="result-icon" aria-hidden="true">→</div>
  <p class="eyebrow">Parent control</p>
  <h1>Welcome <span class="gradient-text">back</span></h1>
  <p class="lede">Sign in to manage your family’s screen time.</p>
  <%= form_with url: session_path, class: "stack" do |form| %>
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autocomplete: "email", autofocus: true %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    <%= form.submit "Sign in", class: "primary-button" %>
  <% end %>
</section>
