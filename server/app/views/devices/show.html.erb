<% content_for :title, "#{@device.name} · Sandy" %>
<%= link_to "← Dashboard", root_path %>
<section class="panel"><h1><%= @device.name %></h1><p>Status: <strong><%= @device.dashboard_status %></strong> · Agent <%= @device.agent_version || "unknown" %> · State version <%= @device.state_version %></p></section>
<section class="panel history"><h2>Time grants</h2><% @grants.each do |grant| %><p><%= l(grant.created_at, format: :short) %> — <strong><%= grant.parent_profile.name %></strong> added <%= grant.duration_seconds / 60 %> minutes; deadline <%= l(grant.resulting_expires_at, format: :short) %>.</p><% end %></section>
<section class="panel history"><h2>Events</h2><% @events.each do |event| %><p><%= l(event.occurred_at, format: :short) %> — <strong><%= event.kind.humanize %></strong><% if event.details.present? %>: <%= event.details.to_json %><% end %></p><% end %></section>
<% if current_parent_profile && !@device.revoked_at? %>
  <section class="panel danger-zone">
    <h2>Revoke this PC</h2>
    <p>The agent will lose access immediately and must be enrolled again with the current family join code.</p>
    <%= button_to "Revoke #{@device.name}", device_path(@device), method: :delete, class: "danger-button", form: { data: { turbo_confirm: "Revoke this PC?" } } %>
  </section>
<% end %>
