<% content_for :title, "#{@device.name} · Sandy" %>
<%= link_to "← Dashboard", root_path, class: "back-link" %>
<section class="panel detail-hero" aria-labelledby="device-title">
  <p class="eyebrow">PC details</p>
  <h1 id="device-title"><%= @device.name %></h1>
  <p class="detail-summary">Enrollment status, time-grant history, and agent activity in one place.</p>
  <div class="detail-stats">
    <div class="detail-stat"><span>Status</span><strong><%= @device.revoked_at? ? "Unenrolled" : @device.dashboard_status.humanize %></strong></div>
    <div class="detail-stat"><span>Agent</span><strong><%= @device.agent_version || "Unknown" %></strong></div>
    <div class="detail-stat"><span>State version</span><strong><%= @device.state_version %></strong></div>
  </div>
</section>
<div class="content-grid">
  <section class="panel history" aria-labelledby="grants-title">
    <div class="panel-heading">
      <h2 id="grants-title">Time grants</h2>
      <div class="panel-actions">
        <span class="panel-kicker"><%= pluralize(@grant_count, "grant") %></span>
        <% if @grant_count > DevicesController::HISTORY_PREVIEW_SIZE %><%= link_to "View all", device_time_grants_path(@device), class: "history-link" %><% end %>
      </div>
    </div>
    <%= render "time_grants", grants: @grants %>
  </section>
  <section class="panel history" aria-labelledby="events-title">
    <div class="panel-heading">
      <h2 id="events-title">Events</h2>
      <div class="panel-actions">
        <span class="panel-kicker"><%= pluralize(@event_count, "event") %></span>
        <% if @event_count > DevicesController::HISTORY_PREVIEW_SIZE %><%= link_to "View all", device_events_path(@device), class: "history-link" %><% end %>
      </div>
    </div>
    <%= render "events", events: @events %>
  </section>
</div>
<section class="panel diagnostics" aria-labelledby="diagnostics-title" data-controller="clipboard">
  <div class="panel-heading">
    <div><p class="eyebrow">Troubleshooting</p><h2 id="diagnostics-title">Agent diagnostics</h2></div>
    <div class="panel-actions">
      <span class="panel-kicker"><%= pluralize(@diagnostic_count, "entry") %></span>
      <% if @diagnostic_count > DevicesController::HISTORY_PREVIEW_SIZE %><%= link_to "View all", device_diagnostics_path(@device), class: "history-link" %><% end %>
    </div>
  </div>
  <div class="diagnostics-toolbar">
    <p>Structured agent reports only. Credentials, raw exception messages, and stack traces are not uploaded.</p>
    <button type="button" class="secondary-button" data-action="clipboard#copy" data-clipboard-target="button" <%= "disabled" if @diagnostics.empty? %>>Copy diagnostics</button>
  </div>
  <%= render "diagnostics", diagnostics: @diagnostics %>
</section>
<% if current_parent_profile && !@device.revoked_at? %>
  <section class="panel danger-zone" aria-labelledby="danger-title">
    <p class="eyebrow">Danger zone</p>
    <h2 id="danger-title">Unenroll this PC</h2>
    <% if current_family.allow_revoked_devices? %>
      <p>Sandy 1.x will receive a long-lived active state. Sandy 2.0 will show current-code re-enrollment immediately.</p>
    <% else %>
      <p>The agent will lose access immediately and must be enrolled again with the current family join code.</p>
    <% end %>
    <%= button_to "Unenroll #{@device.name}", device_path(@device), method: :delete, class: "danger-button", form: { data: { turbo_confirm: "Unenroll this PC?" } } %>
  </section>
<% end %>
